ENV=development
LOG_LEVEL=INFO

# Postgres — host-side values for running alembic/tests from your machine;
# the api/worker containers override these to point at the `postgres` service (see docker-compose.yml).
# Host port is 5433 (not 5432) because this machine already runs a system-wide Postgres on 5432.
DATABASE_URL=postgresql+asyncpg://jaagir:jaagir@localhost:5433/jaagir_sathi
DATABASE_URL_SYNC=postgresql+psycopg://jaagir:jaagir@localhost:5433/jaagir_sathi

REDIS_URL=redis://localhost:6379/0

# S3-compatible storage (MinIO locally)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=jaagir-resumes
S3_REGION=us-east-1

# LLM + embeddings + answer transcription — Gemini.
# The second key is optional and comes from a different Google account: the free
# tier meters per project, so it's a second quota pool that every Gemini call
# falls over to on a 429.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_STT_MODEL=gemini-2.5-flash

# Interviewer voice (ElevenLabs). Optional — without a key the browser's own
# speech synthesis is used instead, which is worse but never blocks a session.
ELEVEN_LABS_API_KEY=
ELEVEN_LABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVEN_LABS_MODEL_ID=eleven_turbo_v2_5
ELEVEN_LABS_OUTPUT_FORMAT=mp3_44100_64
ELEVEN_LABS_STT_MODEL=scribe_v1

# Auth
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# Usage limits (free tier — no billing yet)
FREE_TIER_MONTHLY_MATCH_LIMIT=5
FREE_TIER_MONTHLY_INTERVIEW_LIMIT=10

# Interview state machine
INTERVIEW_MAX_FOLLOWUPS_PER_QUESTION=2
INTERVIEW_HARD_CAP_MINUTES=20
INTERVIEW_HARD_CAP_QUESTIONS=8

# Resume upload
MAX_RESUME_FILE_SIZE_MB=10

# Per-attempt ceiling on any Gemini call (seconds). Question-plan generation
# legitimately runs 5-15s; this exists so a hung connection can't run forever.
GEMINI_TIMEOUT_SECONDS=60

# A job description goes straight into an LLM prompt and an embedding call.
MAX_JOB_DESCRIPTION_CHARS=50000

# Stale-match sweep. A match stuck in pending/processing past this is declared
# failed, so a lost RQ job doesn't leave the UI polling forever.
STALE_MATCH_AFTER_SECONDS=600
STALE_MATCH_SWEEP_INTERVAL_SECONDS=300

# Browser origins allowed to call this API, comma-separated. Was "*"; set this
# to your real frontend origin before deploying anywhere.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
